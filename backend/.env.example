# --- API keys ---
GEMINI_API_KEY=
ELEVENLABS_API_KEY=            # optional fallback for transcribe/translate
ANTHROPIC_API_KEY=             # optional: Claude does the "tighten long lines" step instead of Gemini
DUB_PROVIDER=gemini            # gemini | elevenlabs | local

# --- security (REQUIRED in production) ---
SECRET_KEY=                    # long random string: python -c "import secrets;print(secrets.token_hex(32))"
CORS_ORIGINS=https://app.example.com,https://admin.example.com   # the browser apps allowed to call the API (explicit list, never *: the session is a cookie)
# Browser sessions are httpOnly cookies. The two apps share the API's cookie jar, so admin sessions are only accepted from the ADMIN dashboard's origin
# (the browser sets Origin, a script in the normal app cannot forge it). Must be listed in CORS_ORIGINS too.
ADMIN_ORIGINS=https://admin.example.com
# Cookies are SameSite=strict by default: the apps and the API must share ONE registrable domain (app.example.com + admin.example.com + api.example.com).
# Different domains (app.com + api.net) would make the cookie a third-party cookie that browsers block: then use COOKIE_SAMESITE=none (needs HTTPS)
# and accept the weaker CSRF position, or put the API under the apps' domain (recommended).
COOKIE_SAMESITE=strict
COOKIE_SECURE=auto             # auto = Secure when the browser used HTTPS (also behind a TRUSTED_PROXY that sends X-Forwarded-Proto) | 1 | 0
ALLOW_SIGNUP=true              # false = nobody can register; you create accounts with manage.py / the admin dashboard
# Self-service sign-ups get a small TRIAL (an admin raises it per user); accounts you create yourself get DEFAULT_*_MINUTES below.
SIGNUP_DAILY_MINUTES=10
SIGNUP_MONTHLY_MINUTES=30
SIGNUP_MAX_PER_DAY=100         # new accounts per day, all addresses together (0 = no cap). When hit: sign-ups pause + an admin alert
# Behind a reverse proxy (nginx / Caddy / a cloud load balancer) set this to the proxy's address or network, e.g. 172.18.0.0/16 or 10.0.0.5.
# Then the real client address is read from X-Forwarded-For (only when the request comes from one of these). Left empty the header is ignored
# (safe, but every visitor then looks like the proxy and shares one login limit!).
TRUSTED_PROXIES=
# Limit the owner dashboard API (/api/admin/*) to these addresses (comma separated IPs / CIDRs, e.g. 203.0.113.7,10.8.0.0/24). Everyone else gets 404.
# Empty = allowed from anywhere. Needs TRUSTED_PROXIES behind a proxy, else it only ever sees the proxy's address.
ADMIN_ALLOWED_IPS=
# Login / signup limits (attempts per 15 min unless noted; only WRONG passwords count). REDIS_URL makes them shared by all API workers.
LOGIN_PER_PAIR=5               # one account from one address
LOGIN_PER_ACCOUNT=20           # one account from all addresses together
LOGIN_PER_IP=30                # one address, all accounts
REGISTER_PER_IP=10             # signups per hour per address
# Sessions. Admin accounts get SHORT tokens that the dashboard renews every 10 minutes while it is open; a password reset, disable/enable,
# promote/demote or "log out everywhere" cancels all tokens of that account at once.
TOKEN_DAYS=14                  # normal accounts: life of one token
USER_SESSION_DAYS=60           # normal accounts: renewals stop this long after the password was typed
ADMIN_TOKEN_MINUTES=60         # admin accounts: life of one token
ADMIN_SESSION_HOURS=12         # admin accounts: renewals stop this long after the password was typed (then sign in again)
# Password hashing (scrypt). The settings are stored inside every hash, so changing them is safe: old hashes keep working and each account is
# upgraded the next time its owner logs in. Defaults = OWASP-listed set (32 MiB, ~0.4 s on a laptop). On a very small server lower P (1 = 3x faster
# and weaker). Each login costs this much CPU; the login rate limits bound how often it can be triggered.
PASSWORD_SCRYPT_LOG2_N=15
PASSWORD_SCRYPT_P=3

# Media tools (ffmpeg, ffprobe, Demucs) run with a scrubbed environment (no keys) and, on Linux, under prlimit. Memory ceilings belong to the container (mem_limit).
SANDBOX_CPU_SECONDS=3600       # CPU time of one ffmpeg / Demucs run
SANDBOX_MAX_FILE_MB=16384      # largest file one run may write
SANDBOX_MEMORY_MB=0            # address-space ceiling per run, 0 = off (torch / ffmpeg map a lot of virtual memory)

# --- limits (protect your Gemini bill) ---
DEFAULT_DAILY_MINUTES=100      # per user per UTC day
DEFAULT_MONTHLY_MINUTES=2000  # per user per UTC calendar month
MAX_VIDEO_MINUTES=15
MAX_UPLOAD_MB=1024
MAX_ACTIVE_JOBS_PER_USER=2
GLOBAL_DAILY_MINUTES=0         # 0 = unlimited; set a ceiling for all users combined
MAINTENANCE_MODE=              # 1 = stop accepting new videos (kill switch)

# --- scaling ---
REDIS_URL=                     # set to use the queue + separate workers (run ./run_worker.sh); empty = in-process, dev only
DATABASE_URL=                  # default SQLite; production: postgresql+psycopg://user:pass@host/db
TTS_WORKERS=8
STORAGE_BACKEND=local          # local | s3 (required when workers are on other machines)
FILE_TTL_HOURS=24
S3_BUCKET=
S3_ENDPOINT=                   # e.g. https://sgp1.digitaloceanspaces.com
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Burmese characters per second the TTS voice reads (used in the Gemini prompt and to flag too-long lines)
BURMESE_CPS=10
# Parallel jobs = number of worker processes (used for the queue wait estimate)
QUEUE_WORKERS=2

# Seconds after which a job fails instead of hanging (Gemini slow/busy). Default 720.
JOB_HARD_LIMIT_SECONDS=720
# 1 = if the DUB_PROVIDER fails, fall back to ElevenLabs then the local model (slow / costs credits). Default off.
DUB_FALLBACK=0

# TTS model pool: name:requests-per-minute:requests-per-day, in preference order (defaults in tts_pool.py)
# TTS_MODELS=gemini-3.1-flash-tts-preview:10:100,gemini-2.5-flash-preview-tts:10:100

# Full-movie mode
# EMOTION_MAX_LINES=12      emotional lines voiced one per request
# CAPTION_SIZE_FACTOR=0.8   caption font px = this x original subtitle text height
# GEMINI_TEXT_TIMEOUT_MS=180000

# Full mode character identity: roster (whole-film pass first, default) or unify (per-chunk labels merged afterwards)
SPEAKER_MODE=roster
LLM_CASTING=1

# Allowed browser origins. In production list BOTH sub-domains, e.g.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# (dev defaults already include the app on :3000 and the admin on :3001)

# Admin > Voice models: show Google's REAL limits and usage (optional; without it the page shows our own counters).
# 1. Google Cloud console, the project of your AI Studio key: enable "Service Usage API" and "Cloud Monitoring API".
# 2. IAM & Admin > Service accounts > create one, give it the roles "Service Usage Viewer" and "Monitoring Viewer".
# 3. Keys > Add key > JSON. Save the file OUTSIDE the git repo, never commit it.
# GCP_PROJECT_ID=your-project-id
# GCP_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json

# Google Cloud Text-to-Speech as extra voice capacity (used after the AI Studio models; needs the two GCP_ settings above)
# CLOUD_TTS=1            # 0 = never use Cloud
# CLOUD_TTS_RPM=30       # our per-minute cap for Cloud models (Google's real quota is higher)
# CLOUD_TTS_RPD=5000     # our soft per-day cap

# Admission control (capacity.py). The money budget itself is typed in the admin dashboard (Settings) or `manage.py set-budget THB`.
# COST_PER_MINUTE_THB=1.0               # default cost of one video minute (the dashboard value wins)
# MIN_FREE_MINUTES=30                   # video minutes of budget that are never handed out
# TTS_REQUESTS_PER_VIDEO_MINUTE=6       # estimate of voice requests per video minute (reserved per video)
# ADMIN_WEBHOOK_URL=                    # optional chat webhook (Slack/Discord style, JSON {"text","content"}) for "server busy" alerts, max 1/hour
# USD_THB=35                          # default USD->THB rate for pricing token usage (the dashboard value wins)

# Azure Neural TTS (last fallback, RECAP videos only; Burmese voices my-MM-NilarNeural female / my-MM-ThihaNeural male). Server-side only: never in frontend code or git.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia
# AZURE_TTS=1                          # 0 = never use Azure
# AZURE_TTS_RPM=120 / AZURE_TTS_RPD=100000   # our soft caps (Azure S0 allows 200 requests/s)
