[{"text": "မင်း အဘိုးနာမည် မခေါ်နဲ့။", "source": "赵明辉，你不配提爷爷的名字！"}, {"text": "အဖေ၊ ဘယ်သူဗိုလ်ကျနေလဲ သိထား။", "source": "爸，您搞清楚，现在是谁说了算！"}, {"text": "ကုမ္ပဏီက ကျောက်မျိုးရိုးဖြစ်ပြီ။", "source": "公司马上就要改姓赵！"}, {"text": "ရှူယန်ကို လွှဲပေးလိုက်။", "source": "交出许言！"}, {"text": "သိပ်ကောင်းတာပေါ့ ကိုကို၊", "source": "那就太好了，明辉哥，"}, {"text": "သိပြီးသားပါ။", "source": "人家就知道你可以！"}, {"text": "မင်းတို့ ရှောင်းယန်ကို သတ်တာ၊", "source": "就是你们，害了小言，"}, {"text": "ရှူမိသားစုကိုပါ ဝါးမြိုမှာလား။", "source": "还要吃许氏绝户！"}]
